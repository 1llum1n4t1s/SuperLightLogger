<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>SuperLightLogger</PackageId>
    <Description>log4net互換APIで呼び出せるMicrosoft.Extensions.Loggingラッパー。usingを書き換えるだけで移行完了。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Microsoft.Extensions.* 11.x は net8.0 / netstandard2.0 系を正式サポートしない（未サポート警告を出し netstandard2.0 資産へフォールバックする）。
       そのため net11.0 系の脚だけ 11.x を参照し、それ以外の脚は 10.0.x 系の最新パッチに留めて、下位 TFM 利用者へ非サポート版を持ち込まない。
       注意: Dependabot が既定値 (10.0.x) を 11.x へ上げる PR を出した場合は、この分離が崩れるので取り込まないこと。 -->
  <PropertyGroup>
    <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsVersion Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">11.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <!-- ネイティブAOT / トリミング対応 (netstandard2.0 はサポート対象外) -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuperLightLogger.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

</Project>
